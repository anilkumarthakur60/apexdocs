{
    "name": "anil/apexdocs",
    "description": "Framework-agnostic OpenAPI 3.1 documentation generator. Works with Laravel, Symfony, Slim, or any PHP 8.2 project. Zero framework dependencies in the core.",
    "keywords": ["openapi", "api", "documentation", "swagger", "php", "postman", "insomnia", "webhook"],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name":     "Anil Kumar Thakur",
            "email":    "anilkumarthakur60@gmail.com",
            "homepage": "https://github.com/anilkumarthakur60",
            "role":     "Maintainer"
        }
    ],

    "require": {
        "php": "^8.2",
        "phpstan/phpdoc-parser": "^1.0 || ^2.0",
        "symfony/yaml": "^6.4 || ^7.0",
        "psr/simple-cache": "^3.0",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/container": "^2.0"
    },

    "require-dev": {
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0 || ^4.0",
        "laravel/framework": "^11.0 || ^12.0",
        "orchestra/testbench": "^9.0 || ^10.0",
        "nyholm/psr7": "^1.8"
    },

    "suggest": {
        "laravel/framework": "Required for the Laravel bridge (ApexDocs\\Bridge\\Laravel)",
        "symfony/framework-bundle": "Required for the Symfony bridge (ApexDocs\\Bridge\\Symfony)"
    },

    "autoload": {
        "psr-4": {
            "ApexDocs\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ApexDocs\\Tests\\": "tests/"
        }
    },

    "extra": {
        "branch-alias": {
            "dev-main": "0.x-dev"
        },
        "laravel": {
            "providers": ["ApexDocs\\Bridge\\Laravel\\ServiceProvider"],
            "aliases":   {"ApexDocs": "ApexDocs\\Bridge\\Laravel\\Facade"}
        }
    },

    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test":          "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage"
    },
    "support": {
        "issues": "https://github.com/anilkumarthakur60/apexdocs/issues",
        "source": "https://github.com/anilkumarthakur60/apexdocs",
        "docs":   "https://github.com/anilkumarthakur60/apexdocs#readme"
    }
}
